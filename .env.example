# SIFRA — AI Terminal Assistant
# Copy this file to ".env"
# No API key required — SIFRA securely uses the backend server.

# SIFRA Backend URL
SIFRA_BACKEND_URL=https://sifra-backend-am6p.onrender.com

# Run SIFRA using the backend
MODE=backend

# Maximum conversation messages to remember
MAX_CONTEXT_MESSAGES=50

# ─────────────────────────────────────────────────────────────────────────────
# SIFRA – AI Terminal Assistant  |  .env.example
#
# Copy this file to ".env" and fill in your values.
# Never commit your real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Your AI provider API key (OpenAI, Groq, Together AI, etc.)
AI_API_KEY=your_api_key_here

# The model name to use
# OpenAI examples  : gpt-4o-mini  |  gpt-4o  |  gpt-3.5-turbo
# Groq examples    : llama3-8b-8192  |  mixtral-8x7b-32768
# Ollama example   : llama3  (local, no key needed — set AI_API_KEY=ollama)
AI_MODEL=gpt-4o-mini

# ── Optional ──────────────────────────────────────────────────────────────────

# Base URL for the AI API  (change this to switch providers)
# OpenAI  (default): https://api.openai.com/v1
# Groq             : https://api.groq.com/openai/v1
# Ollama (local)   : http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1

# Maximum number of messages kept in session context window (default: 30)
MAX_CONTEXT_MESSAGES=30

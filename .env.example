# SIFRA – AI Terminal Assistant  |  .env.example
# Copy this file to ".env" and fill in ONLY the backend URL below.
# No API key required — the key lives on the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# The deployed SIFRA backend URL (get this from the project author)
SIFRA_BACKEND_URL=https://sifra-backend.onrender.com

# ── Do NOT change these unless you know what you are doing ────────────────────
MODE=backend
